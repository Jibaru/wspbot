{
  "name": "wspbot",
  "version": "0.1.0",
  "private": true,
  "description": "A WhatsApp bot that answers when tagged — searches the web and remembers what you tell it.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "cron-check": "tsx scripts/cron-check.mts",
    "contrast-check": "tsx scripts/contrast-check.mts",
    "summary-check": "tsx --conditions=react-server --env-file=.env scripts/summary-check.mts",
    "transfer-check": "tsx --conditions=react-server --env-file=.env scripts/transfer-check.mts",
    "supporters-check": "tsx --conditions=react-server --env-file=.env scripts/supporters-check.mts",
    "roadmap-check": "tsx --conditions=react-server --env-file=.env scripts/roadmap-check.mts",
    "features-check": "tsx --conditions=react-server scripts/features-check.mts",
    "wapi-check": "tsx --conditions=react-server --env-file=.env scripts/wapi-check.mts",
    "vendor-wapi-sdk": "node scripts/vendor-wapi-sdk.mjs",
    "sticker-check": "tsx --conditions=react-server scripts/sticker-check.mts",
    "voice-check": "tsx --conditions=react-server scripts/voice-check.mts",
    "draw-check": "tsx --conditions=react-server scripts/draw-check.mts",
    "render-check": "tsx --conditions=react-server --env-file-if-exists=.env scripts/render-check.mts",
    "models-check": "tsx --conditions=react-server scripts/models-check.mts",
    "video-check": "tsx --conditions=react-server scripts/video-check.mts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.46",
    "ai": "^7.0.77",
    "bcryptjs": "^3.0.3",
    "next": "^16.3.2",
    "pg": "^8.23.0",
    "puppeteer-core": "^25.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
